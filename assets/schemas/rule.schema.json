{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence-based engineering rule",
  "type": "object",
  "required": [
    "id",
    "title",
    "category",
    "classification",
    "severity",
    "scope",
    "condition",
    "requirement",
    "verification",
    "confidence",
    "sources"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9-]+-[0-9]{3}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string"
    },
    "classification": {
      "enum": [
        "STANDARD",
        "RECOMMENDED",
        "PROJECT_REQUIRED",
        "USER_REQUIRED",
        "OBSERVED",
        "PROPOSED"
      ]
    },
    "severity": {
      "enum": [
        "MUST",
        "MUST_NOT",
        "SHOULD",
        "MAY"
      ]
    },
    "scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "condition": {
      "type": "string",
      "minLength": 1
    },
    "requirement": {
      "type": "string",
      "minLength": 1
    },
    "verification": {
      "type": "object",
      "required": [
        "type",
        "description"
      ],
      "properties": {
        "type": {
          "type": "string"
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "prohibition": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "key": {
      "type": "string"
    },
    "value": {
      "type": "string"
    },
    "exclusive": {
      "type": "boolean"
    },
    "independent": {
      "type": "boolean"
    },
    "migration_class": {
      "enum": [
        "general",
        "technology",
        "enterprise",
        "project",
        "inapplicable"
      ]
    },
    "technologies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "object",
      "required": [
        "path",
        "locator"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "locator": {
          "type": "string"
        },
        "type": {
          "type": "string"
        }
      }
    }
  }
}
